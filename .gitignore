# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production & binary artifacts
/build
*.apk
*.aab
artifacts/*.apk

# mobile / android
.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/local.properties
**/android/.cxx/
*.keystore
!**/android/app/debug.keystore

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local uploaded files & session caches
*.pdf
/public/uploads/


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
