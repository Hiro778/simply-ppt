# Simply PPT Environment Variables
# Copy this file to .env.local and update with your project credentials.

# Supabase Configuration
# Used for real-time cloud pairing between Desktop and mobile controllers.
# NOTE: Only use the public anonymous key here. NEVER expose your service_role key!
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Application Settings
NEXT_PUBLIC_APP_NAME="Simply PPT"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
